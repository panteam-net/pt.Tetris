      "comment": "Arguments: game mode, player 1 wins, player 2 wins.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "%1$@  ·  %2$ld : %3$ld" } },
        "ru": { "stringUnit": { "state": "translated", "value": "%1$@  ·  %2$ld : %3$ld" } }
