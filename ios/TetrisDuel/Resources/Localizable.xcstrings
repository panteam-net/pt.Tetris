        "ru": { "stringUnit": { "state": "translated", "value": "Включить звук и вибрацию" } }
      }
    },
    "game.notice.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Connection lost. The match is stopped; no winner is awarded." } },
