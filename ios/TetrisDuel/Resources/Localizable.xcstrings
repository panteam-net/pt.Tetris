      }
    },
    "lobby.join.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Choose a host below. Both devices need Wi-Fi\nand Local Network permission enabled." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Выберите игру ниже. На обоих устройствах включите Wi-Fi\nи разрешите доступ к локальной сети." } }
      }
    },
    "lobby.invitation.title": {
      "comment": "The argument is the nearby player's name.",
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Play with %1$@?" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Сыграть с игроком %1$@?" } }
      }
